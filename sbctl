#!/bin/bash

# sbctl - Sing-Box 管理工具
# https://github.com/sail-tunnel/sbctl

set -e

SBCTL_VERSION="1.0.0"
CONFIG_FILE="/etc/sing-box/config.json"
CONFIG_DIR="/etc/sing-box"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# ============================================================
# 帮助
# ============================================================
show_help() {
    cat <<EOF
${CYAN}sbctl${NC} v${SBCTL_VERSION} - Sing-Box 管理工具

${YELLOW}用法:${NC}
    sbctl <命令> [选项]

${YELLOW}命令:${NC}
    init       初始化配置（首次安装后运行）
    status     查看服务运行状态
    show       显示当前连接信息和分享链接
    restart    重启 sing-box 服务
    stop       停止 sing-box 服务
    start      启动 sing-box 服务
    log        查看服务日志
    uninstall  卸载 sbctl（不删除 sing-box）
    help       显示此帮助

${YELLOW}init 选项:${NC}
    -r, --remark REMARK  备注名称（默认: myserver）
    -p, --port PORT      监听端口（默认: 随机生成）
    -P, --protocol PROTO 协议: shadowsocks / vmess / hysteria2 / wireguard

${YELLOW}支持协议:${NC}
    shadowsocks   Shadowsocks 2022（推荐，抗检测）
    vmess         VMess + WebSocket（兼容性好）
    hysteria2     Hysteria2（基于 QUIC，速度快）
    wireguard     WireGuard（内核级 VPN）

${YELLOW}示例:${NC}
    sbctl init -r myserver -P shadowsocks
    sbctl init -r myserver -p 8080 -P vmess
    sbctl status
    sbctl show
    sbctl restart
EOF
}

# ============================================================
# 工具函数
# ============================================================
check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "请使用 root 权限运行: sudo sbctl $*"
        exit 1
    fi
}

generate_password() {
    openssl rand -base64 32
}

generate_uuid() {
    if command -v uuidgen &>/dev/null; then
        uuidgen | tr '[:upper:]' '[:lower:]'
    else
        cat /proc/sys/kernel/random/uuid 2>/dev/null \
            || python3 -c "import uuid; print(uuid.uuid4())"
    fi
}

generate_wg_keys() {
    if command -v wg &>/dev/null; then
        local priv pub
        priv=$(wg genkey)
        pub=$(echo "$priv" | wg pubkey)
        echo "$priv $pub"
    else
        local keys priv pub
        keys=$(sing-box generate wireguard-keypair 2>/dev/null || true)
        if [ -n "$keys" ]; then
            priv=$(echo "$keys" | grep "PrivateKey" | awk '{print $2}')
            pub=$(echo  "$keys" | grep "PublicKey"  | awk '{print $2}')
            echo "$priv $pub"
        else
            log_error "无法生成 WireGuard 密钥，请安装 wireguard-tools"
            exit 1
        fi
    fi
}

get_public_ip() {
    curl -s -4 ifconfig.me \
        || curl -s -4 icanhazip.com \
        || curl -s -4 api.ipify.org
}

validate_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

generate_random_port() {
    echo $((RANDOM % 55536 + 10000))
}

url_encode() {
    python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$1" 2>/dev/null || echo "$1"
}

# ============================================================
# 配置生成
# ============================================================
write_config_shadowsocks() {
    local port=$1 remark=$2 server_pass=$3 user_pass=$4
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "level": "info" },
  "dns": {
    "servers": [{ "address": "tls://8.8.8.8" }]
  },
  "inbounds": [
    {
      "type": "shadowsocks",
      "listen": "::",
      "listen_port": ${port},
      "method": "2022-blake3-aes-256-gcm",
      "password": "${server_pass}",
      "users": [{ "name": "${remark}", "password": "${user_pass}" }],
      "multiplex": { "enabled": true, "padding": true }
    }
  ],
  "outbounds": [{ "type": "direct" }],
  "route": {
    "rules": [{ "protocol": "dns", "action": "hijack-dns" }]
  }
}
EOF
}

write_config_vmess() {
    local port=$1 remark=$2 uuid=$3
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "level": "info" },
  "dns": {
    "servers": [{ "address": "tls://8.8.8.8" }]
  },
  "inbounds": [
    {
      "type": "vmess",
      "listen": "::",
      "listen_port": ${port},
      "users": [{ "name": "${remark}", "uuid": "${uuid}", "alterId": 0 }],
      "transport": { "type": "ws", "path": "/vmess" }
    }
  ],
  "outbounds": [{ "type": "direct" }],
  "route": {
    "rules": [{ "protocol": "dns", "action": "hijack-dns" }]
  }
}
EOF
}

write_config_hysteria2() {
    local port=$1 remark=$2 password=$3
    mkdir -p "${CONFIG_DIR}/certs"
    log_info "生成自签名 TLS 证书..."
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -keyout "${CONFIG_DIR}/certs/server.key" \
        -out    "${CONFIG_DIR}/certs/server.crt" \
        -days 3650 -nodes -subj "/CN=hysteria2" 2>/dev/null
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "level": "info" },
  "dns": {
    "servers": [{ "address": "tls://8.8.8.8" }]
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "listen": "::",
      "listen_port": ${port},
      "users": [{ "name": "${remark}", "password": "${password}" }],
      "tls": {
        "enabled": true,
        "certificate_path": "${CONFIG_DIR}/certs/server.crt",
        "key_path": "${CONFIG_DIR}/certs/server.key"
      }
    }
  ],
  "outbounds": [{ "type": "direct" }],
  "route": {
    "rules": [{ "protocol": "dns", "action": "hijack-dns" }]
  }
}
EOF
}

write_config_wireguard() {
    local port=$1 remark=$2 server_priv=$3 client_pub=$4 psk=$5
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "level": "info" },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wg-in",
      "listen_port": ${port},
      "system": false,
      "name": "wg0",
      "mtu": 1408,
      "address": ["10.0.0.1/24", "fd00::1/64"],
      "private_key": "${server_priv}",
      "peers": [
        {
          "public_key": "${client_pub}",
          "pre_shared_key": "${psk}",
          "allowed_ips": ["10.0.0.2/32", "fd00::2/128"]
        }
      ]
    }
  ],
  "inbounds": [
    {
      "type": "direct",
      "tag": "direct-in",
      "listen": "::",
      "listen_port": $((port + 1))
    }
  ],
  "outbounds": [{ "type": "direct" }]
}
EOF
}

# ============================================================
# 链接 / 输出
# ============================================================
print_ss_result() {
    local ip=$1 port=$2 remark=$3 server_pass=$4 user_pass=$5
    local creds encoded link sub
    creds="2022-blake3-aes-256-gcm:${server_pass}:${user_pass}"
    encoded=$(echo -n "$creds" | base64 -w 0)
    link="ss://${encoded}@${ip}:${port}#$(url_encode "$remark")"
    sub=$(echo -n "$link" | base64 -w 0)

    echo ""
    echo -e "${CYAN}========== Shadowsocks 2022 ==========${NC}"
    echo -e "${BLUE}服务器:${NC} $ip"
    echo -e "${BLUE}端口:${NC}   $port"
    echo -e "${BLUE}备注:${NC}   $remark"
    echo ""
    echo -e "${GREEN}分享链接:${NC}"
    echo "$link"
    echo ""
    echo -e "${GREEN}Base64 订阅:${NC}"
    echo "$sub"
    echo -e "${CYAN}======================================${NC}"
}

print_vmess_result() {
    local ip=$1 port=$2 remark=$3 uuid=$4
    local json encoded link sub
    json="{\"v\":\"2\",\"ps\":\"${remark}\",\"add\":\"${ip}\",\"port\":${port},\"id\":\"${uuid}\",\"aid\":0,\"net\":\"ws\",\"type\":\"none\",\"host\":\"\",\"path\":\"/vmess\",\"tls\":\"\"}"
    encoded=$(echo -n "$json" | base64 -w 0)
    link="vmess://${encoded}"
    sub=$(echo -n "$link" | base64 -w 0)

    echo ""
    echo -e "${CYAN}========== VMess + WebSocket ==========${NC}"
    echo -e "${BLUE}服务器:${NC} $ip"
    echo -e "${BLUE}端口:${NC}   $port"
    echo -e "${BLUE}UUID:${NC}   $uuid"
    echo -e "${BLUE}传输:${NC}   WebSocket /vmess"
    echo -e "${BLUE}备注:${NC}   $remark"
    echo ""
    echo -e "${GREEN}分享链接:${NC}"
    echo "$link"
    echo ""
    echo -e "${GREEN}Base64 订阅:${NC}"
    echo "$sub"
    echo -e "${CYAN}=======================================${NC}"
}

print_hysteria2_result() {
    local ip=$1 port=$2 remark=$3 password=$4
    local link sub
    link="hy2://${password}@${ip}:${port}?insecure=1#$(url_encode "$remark")"
    sub=$(echo -n "$link" | base64 -w 0)

    echo ""
    echo -e "${CYAN}========== Hysteria2 ==========${NC}"
    echo -e "${BLUE}服务器:${NC} $ip"
    echo -e "${BLUE}端口:${NC}   $port"
    echo -e "${BLUE}备注:${NC}   $remark"
    echo -e "${YELLOW}注意:${NC}   使用自签名证书，客户端需开启 insecure/跳过验证"
    echo ""
    echo -e "${GREEN}分享链接:${NC}"
    echo "$link"
    echo ""
    echo -e "${GREEN}Base64 订阅:${NC}"
    echo "$sub"
    echo -e "${CYAN}===============================${NC}"
}

print_wireguard_result() {
    local ip=$1 port=$2 remark=$3
    local client_priv=$4 client_pub=$5 server_pub=$6 psk=$7

    echo ""
    echo -e "${CYAN}========== WireGuard ==========${NC}"
    echo -e "${BLUE}服务器:${NC} $ip"
    echo -e "${BLUE}端口:${NC}   $port"
    echo -e "${BLUE}备注:${NC}   $remark"
    echo ""
    echo -e "${GREEN}客户端配置 (wg0.conf):${NC}"
    cat <<WGCONF
[Interface]
PrivateKey = ${client_priv}
Address = 10.0.0.2/24
DNS = 8.8.8.8

[Peer]
PublicKey = ${server_pub}
PreSharedKey = ${psk}
Endpoint = ${ip}:${port}
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
WGCONF
    echo -e "${CYAN}===============================${NC}"
}

# ============================================================
# 子命令: init
# ============================================================
cmd_init() {
    check_root
    local remark="" port="" protocol=""

    # 解析参数
    while [[ $# -gt 0 ]]; do
        case $1 in
            -r|--remark)   remark="$2";   shift 2 ;;
            -p|--port)     port="$2";     shift 2 ;;
            -P|--protocol) protocol="$2"; shift 2 ;;
            *) log_error "未知选项: $1"; show_help; exit 1 ;;
        esac
    done

    # 备注
    if [ -z "$remark" ]; then
        read -p "请输入备注名称 (默认: myserver): " remark
        remark="${remark:-myserver}"
    fi

    # 协议
    if [ -z "$protocol" ]; then
        echo ""
        echo "请选择协议:"
        echo "  1) Shadowsocks 2022  (推荐)"
        echo "  2) VMess + WebSocket"
        echo "  3) Hysteria2"
        echo "  4) WireGuard"
        echo ""
        read -p "请输入序号 [1-4，默认 1]: " proto_num
        case "$proto_num" in
            2) protocol="vmess"     ;;
            3) protocol="hysteria2" ;;
            4) protocol="wireguard" ;;
            *) protocol="shadowsocks" ;;
        esac
    fi

    # 端口
    if [ -z "$port" ]; then
        port=$(generate_random_port)
        log_info "随机端口: $port"
        read -p "使用此端口? 或输入自定义端口 (回车确认 $port): " custom_port
        [ -n "$custom_port" ] && port="$custom_port"
    fi
    if ! validate_port "$port"; then
        log_error "端口无效: $port"
        exit 1
    fi

    echo ""
    log_info "备注: $remark  |  协议: $protocol  |  端口: $port"
    log_info "生成配置..."
    mkdir -p "$CONFIG_DIR"

    local ip
    ip=$(get_public_ip)

    case "$protocol" in
        shadowsocks)
            local sp up
            sp=$(generate_password)
            up=$(generate_password)
            write_config_shadowsocks "$port" "$remark" "$sp" "$up"
            _restart_service
            print_ss_result "$ip" "$port" "$remark" "$sp" "$up"
            ;;
        vmess)
            local uuid
            uuid=$(generate_uuid)
            write_config_vmess "$port" "$remark" "$uuid"
            _restart_service
            print_vmess_result "$ip" "$port" "$remark" "$uuid"
            ;;
        hysteria2)
            local pw
            pw=$(generate_password)
            write_config_hysteria2 "$port" "$remark" "$pw"
            _restart_service
            print_hysteria2_result "$ip" "$port" "$remark" "$pw"
            ;;
        wireguard)
            if ! command -v wg &>/dev/null; then
                apt install -y wireguard-tools 2>/dev/null || true
            fi
            local s_keys s_priv s_pub c_keys c_priv c_pub psk
            s_keys=$(generate_wg_keys); s_priv=$(echo "$s_keys" | awk '{print $1}'); s_pub=$(echo "$s_keys" | awk '{print $2}')
            c_keys=$(generate_wg_keys); c_priv=$(echo "$c_keys" | awk '{print $1}'); c_pub=$(echo "$c_keys" | awk '{print $2}')
            psk=$(generate_password)
            write_config_wireguard "$port" "$remark" "$s_priv" "$c_pub" "$psk"
            _restart_service
            print_wireguard_result "$ip" "$port" "$remark" "$c_priv" "$c_pub" "$s_pub" "$psk"
            ;;
        *)
            log_error "不支持的协议: $protocol"
            exit 1
            ;;
    esac

    echo ""
    log_info "配置完成！使用 'sbctl show' 随时查看连接信息。"
}

# ============================================================
# 子命令: show（从配置文件读取并展示）
# ============================================================
cmd_show() {
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "未找到配置文件: $CONFIG_FILE，请先运行 'sbctl init'"
        exit 1
    fi

    local proto ip port
    proto=$(python3 -c "import json,sys; d=json.load(open('$CONFIG_FILE')); print(d.get('endpoints', [{}])[0].get('type') if 'endpoints' in d and len(d['endpoints']) > 0 else d['inbounds'][0]['type'])" 2>/dev/null || true)
    port=$(python3 -c "import json,sys; d=json.load(open('$CONFIG_FILE')); print(d.get('endpoints', [{}])[0].get('listen_port') if 'endpoints' in d and len(d['endpoints']) > 0 else d['inbounds'][0]['listen_port'])" 2>/dev/null || true)
    ip=$(get_public_ip)

    echo ""
    log_info "当前协议: ${proto:-未知}  |  端口: ${port:-未知}  |  服务器: $ip"
    echo ""

    case "$proto" in
        shadowsocks)
            local sp up remark
            sp=$(python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['password'])" 2>/dev/null)
            up=$(python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['password'])" 2>/dev/null)
            remark=$(python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['name'])" 2>/dev/null)
            print_ss_result "$ip" "$port" "$remark" "$sp" "$up"
            ;;
        vmess)
            local uuid remark
            uuid=$(python3  -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['uuid'])" 2>/dev/null)
            remark=$(python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['name'])" 2>/dev/null)
            print_vmess_result "$ip" "$port" "$remark" "$uuid"
            ;;
        hysteria2)
            local pw remark
            pw=$(python3    -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['password'])" 2>/dev/null)
            remark=$(python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d['inbounds'][0]['users'][0]['name'])" 2>/dev/null)
            print_hysteria2_result "$ip" "$port" "$remark" "$pw"
            ;;
        wireguard)
            log_warn "WireGuard 密钥在初始化时已显示，请查看当时的输出。"
            log_info "配置文件: $CONFIG_FILE"
            ;;
        *)
            log_warn "无法解析协议类型，请直接查看配置: $CONFIG_FILE"
            ;;
    esac
}

# ============================================================
# 子命令: 服务管理
# ============================================================
_restart_service() {
    log_info "重启 sing-box 服务..."
    systemctl enable sing-box 2>/dev/null || true
    systemctl restart sing-box 2>/dev/null || log_warn "服务重启失败（容器环境下正常）"
}

cmd_start() {
    check_root
    log_info "启动 sing-box..."
    systemctl start sing-box && log_info "已启动" || log_error "启动失败"
}

cmd_stop() {
    check_root
    log_info "停止 sing-box..."
    systemctl stop sing-box && log_info "已停止" || log_error "停止失败"
}

cmd_restart() {
    check_root
    _restart_service
}

cmd_status() {
    systemctl status sing-box --no-pager || true
}

cmd_log() {
    journalctl -u sing-box -n 100 --no-pager
}

cmd_uninstall() {
    check_root
    log_warn "此操作将删除 sbctl，但不会卸载 sing-box。"
    read -p "确认卸载 sbctl? (y/N): " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        rm -f /usr/local/bin/sbctl
        log_info "sbctl 已卸载。"
    else
        log_info "已取消。"
    fi
}

# ============================================================
# 入口
# ============================================================
case "${1:-help}" in
    init)       shift; cmd_init "$@"      ;;
    show)       cmd_show                  ;;
    status)     cmd_status                ;;
    start)      cmd_start                 ;;
    stop)       cmd_stop                  ;;
    restart)    cmd_restart               ;;
    log)        cmd_log                   ;;
    uninstall)  cmd_uninstall             ;;
    help|--help|-h) show_help            ;;
    *)
        log_error "未知命令: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
